<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MedicalSharp</AssemblyName>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <IsPackable>False</IsPackable>
    <Description>MedicalSharp 客户端</Description>
    <AvaloniaUseCompiledBindingsByDefault>False</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="favicon.ico" />
    <AvaloniaResource Include="Content\**" />
    <None Include="App.config" Condition="'$(Configuration)'=='Debug'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Avalonia.Designer.HostApp.dll.config</TargetPath>
    </None>
    <None Include="Content\Fonts\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Resources\Fonts\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.5.1" />
    <PackageReference Include="Caliburn.Micro.Core" Version="5.0.258" />
    <PackageReference Include="Caliburn.Micro.Platform.Core" Version="5.0.181-beta" />
    <PackageReference Include="Caliburn.Micro.Avalonia" Version="5.0.258-beta" />
    <PackageReference Include="MrAdvice" Version="2.20.5" />
    <PackageReference Include="SD.Toolkits.Json" Version="4.0.1" />
    <PackageReference Include="SD.IOC.Core" Version="3.0.1" />
    <PackageReference Include="SD.IOC.Extension.NetCore" Version="3.0.1" />
    <PackageReference Include="SD.Infrastructure" Version="4.0.1" />
    <PackageReference Include="SD.Infrastructure.Avalonia" Version="1.0.12" />
    <PackageReference Include="SD.Infrastructure.Avalonia.Caliburn" Version="1.0.12" />
    <PackageReference Include="SimpleITK.Runtimes.win-x64" Version="2.5.3.2" />
    <PackageReference Include="SimpleITK.Runtimes.linux-x64" Version="2.5.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MedicalSharp.Presentation\MedicalSharp.Presentation.csproj" />
    <ProjectReference Include="..\MedicalSharp.Controls\MedicalSharp.Controls.csproj" />
    <ProjectReference Include="..\MedicalSharp.Engine\MedicalSharp.Engine.csproj" />
    <ProjectReference Include="..\MedicalSharp.Insight\MedicalSharp.Insight.csproj" />
    <ProjectReference Include="..\MedicalSharp.Inspiration\MedicalSharp.Inspiration.csproj" />
    <ProjectReference Include="..\MedicalSharp.Intelligence\MedicalSharp.Intelligence.csproj" />
    <ProjectReference Include="..\MedicalSharp.Primitives\MedicalSharp.Primitives.csproj" />
  </ItemGroup>
</Project>
