<fa:AppWindow x:Class="MedicalSharp.Client.Views.AlgorithmContext.ThresholdSegmentView"
              xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:fa="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
              xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
              xmlns:sd="https://github.com/lishilei0523/SD.Framework"
              mc:Ignorable="d"
              Width="500" Height="300" CanResize="False" ShowAsDialog="True"
              WindowStartupLocation="CenterScreen"
              Title="阈值分割">

    <StackPanel Grid.IsSharedSizeScope="True" Margin="20,20">
        <sd:FormItem Label="低阈值：">
            <NumericUpDown Width="360" HorizontalAlignment="Left"
                           Minimum="-1024" Maximum="3071" Increment="5"
                           ParsingNumberStyle="Integer" FormatString="F0"
                           Value="{Binding MinHU}" />
        </sd:FormItem>
        <sd:FormItem Label="高阈值：">
            <NumericUpDown Width="360" HorizontalAlignment="Left"
                           Minimum="-1024" Maximum="3071" Increment="10"
                           ParsingNumberStyle="Integer" FormatString="F0"
                           Value="{Binding MaxHU}" />
        </sd:FormItem>
        <sd:FormItem>
            <ui:RangeSlider Width="360" HorizontalAlignment="Left"
                            Minimum="-1024" Maximum="3071"
                            RangeStart="{Binding MinHU}" RangeEnd="{Binding MaxHU}"
                            StepFrequency="1" ShowValueToolTip="True" />
        </sd:FormItem>
        <sd:FormItem Label="目标组织：">
            <ComboBox Width="360" ItemsSource="{Binding Tissues}"
                      DisplayMemberBinding="{Binding Name}"
                      SelectedValue="{Binding SelectedTissue}" />
        </sd:FormItem>
    </StackPanel>
</fa:AppWindow>
