<fa:AppWindow x:Class="MedicalSharp.Client.Views.AlgorithmContext.CannyView"
			  xmlns="https://github.com/avaloniaui"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			  xmlns:fa="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
			  xmlns:sd="https://github.com/lishilei0523/SD.Framework"
			  xmlns:cm="http://caliburnmicro.com"
			  mc:Ignorable="d"
			  Width="460" Height="330" CanResize="False" ShowAsDialog="True"
			  WindowStartupLocation="CenterScreen"
			  Title="Canny边缘检测">

	<sd:BusyMask IsBusy="{Binding IsBusy}">
		<Grid>
			<Grid.RowDefinitions>
				<!--表单区-->
				<RowDefinition Height="270" />
				<!--占位区-->
				<RowDefinition Height="*" />
				<!--控制区-->
				<RowDefinition Height="50" />
			</Grid.RowDefinitions>
			<!--表单区-->
			<StackPanel Grid.Row="0" Grid.IsSharedSizeScope="True" Margin="20,20">
				<sd:FormItem Label="低阈值：">
					<NumericUpDown Width="300" HorizontalAlignment="Left"
								   Minimum="5" Maximum="50" Increment="1"
								   ParsingNumberStyle="Float" FormatString="F1"
								   Text="{Binding LowerThreshold}" />
				</sd:FormItem>
				<sd:FormItem Label="高阈值：">
					<NumericUpDown Width="300" HorizontalAlignment="Left"
								   Minimum="20" Maximum="200" Increment="1"
								   ParsingNumberStyle="Float" FormatString="F1"
								   Text="{Binding UpperThreshold}" />
				</sd:FormItem>
				<sd:FormItem Label="标准差：">
					<NumericUpDown Width="300" HorizontalAlignment="Left"
								   Minimum="0.5" Maximum="3.0" Increment="0.1"
								   ParsingNumberStyle="Float" FormatString="F1"
								   Text="{Binding Sigma}" />
				</sd:FormItem>
                <sd:FormItem Label="膨胀半径：">
                    <NumericUpDown Width="300" HorizontalAlignment="Left"
                                   Minimum="1" Maximum="2" Increment="1"
                                   ParsingNumberStyle="Integer" FormatString="F0"
                                   Text="{Binding DilateRadius}" />
                </sd:FormItem>
			</StackPanel>
			<!--占位区-->
			<Grid Grid.Row="1" />
			<!--控制区-->
			<Grid Grid.Row="2" Classes="Submit-Grid">
				<WrapPanel Classes="Submit-WrapPanel">
					<Button Content="应用" cm:Message.Attach="Apply()" Classes="Focus" />
					<Button Content="取消" cm:Message.Attach="TryCloseAsync('false')" />
				</WrapPanel>
			</Grid>
		</Grid>
	</sd:BusyMask>
</fa:AppWindow>
