<UserControl x:Class="MedicalSharp.Client.Views.VolumeContext.VolumeView"
			 xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:cm="http://caliburnmicro.com"
			 xmlns:sd="https://github.com/lishilei0523/SD.Framework"
			 mc:Ignorable="d">

	<sd:GroupBox>
		<!--Header-->
		<sd:GroupBox.Header>
			<Grid>
				<Grid.ColumnDefinitions>
					<!--Toolbar-->
					<ColumnDefinition Width="*" />
					<!--More-->
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<!--Toolbar-->
				<WrapPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
					<sd:ToggleRadioButton cm:Message.Attach="PickVoxel()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.PickVoxelEnabled}">
						<PathIcon Data="{StaticResource Icon-PickVoxel}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="PickShape()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.PickShapeEnabled}">
						<PathIcon Data="{StaticResource Icon-PickShape}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="TranslateNormal()" Classes="Transparent-Panel" IsChecked="True"
										  IsVisible="{Binding ToolbarConfig.TranslateNormalEnabled}">
						<PathIcon Data="{StaticResource Icon-TranslateNormal}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="Translate3D()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.Translate3DEnabled}">
						<PathIcon Data="{StaticResource Icon-Translate3D}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="RotateU()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.RotateUEnabled}">
						<PathIcon Data="{StaticResource Icon-RotateU}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="RotateV()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.RotateVEnabled}">
						<PathIcon Data="{StaticResource Icon-RotateV}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="Rotate3D()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.Rotate3DEnabled}">
						<PathIcon Data="{StaticResource Icon-Rotate3D}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="Resize()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.ResizeEnabled}">
						<PathIcon Data="{StaticResource Icon-Resize}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="EditVertex()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.EditVertexEnabled}">
						<PathIcon Data="{StaticResource Icon-EditVertex}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="DrawPoint()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.DrawPointEnabled}">
						<PathIcon Data="{StaticResource Icon-Point}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="DrawLineSegment()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.DrawLineSegmentEnabled}">
						<PathIcon Data="{StaticResource Icon-LineSegment}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="DrawPolyline()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.DrawPolylineEnabled}">
						<PathIcon Data="{StaticResource Icon-Polyline}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="DrawCurve()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.DrawCurveEnabled}">
						<PathIcon Data="{StaticResource Icon-Curve}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="DrawRectangle()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.DrawRectangleEnabled}">
						<PathIcon Data="{StaticResource Icon-Rectangle}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="DrawCircle()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.DrawCircleEnabled}">
						<PathIcon Data="{StaticResource Icon-Circle}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="DrawEllipse()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.DrawEllipseEnabled}">
						<PathIcon Data="{StaticResource Icon-Ellipse}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="DrawPolygon()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.DrawPolygonEnabled}">
						<PathIcon Data="{StaticResource Icon-Polygon}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="DrawClosedCurve()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.DrawClosedCurveEnabled}">
						<PathIcon Data="{StaticResource Icon-ClosedCurve}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="DrawBox()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.DrawBoxEnabled}">
						<PathIcon Data="{StaticResource Icon-Cube}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="DrawSphere()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.DrawSphereEnabled}">
						<PathIcon Data="{StaticResource Icon-Sphere}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="DrawCylinder()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.DrawCylinderEnabled}">
						<PathIcon Data="{StaticResource Icon-Cylinder}" />
					</sd:ToggleRadioButton>
					<sd:ToggleRadioButton cm:Message.Attach="DrawConvexPolyhedron()" Classes="Transparent-Panel"
										  IsVisible="{Binding ToolbarConfig.DrawConvexPolyhedronEnabled}">
						<PathIcon Data="{StaticResource Icon-Polyhedron}" />
					</sd:ToggleRadioButton>
				</WrapPanel>
				<!--More-->
				<WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
					<DropDownButton Content="VR" Classes="Transparent-Panel">
						<DropDownButton.Flyout>
							<MenuFlyout>
								<MenuItem Header="预览模式(_P)">
									<MenuItem>
										<MenuItem.Header>
											<RadioButton Content="预览模式" GroupName="PreviewMode"
														 IsChecked="{Binding PreviewModeChecked}" />
										</MenuItem.Header>
									</MenuItem>
									<MenuItem>
										<MenuItem.Header>
											<RadioButton Content="原始模式" GroupName="PreviewMode"
														 IsChecked="{Binding OriginalModeChecked}" />
										</MenuItem.Header>
									</MenuItem>
								</MenuItem>
								<MenuItem Header="渲染模式(_R)">
									<MenuItem>
										<MenuItem.Header>
											<RadioButton Content="Raycast" GroupName="RenderMode" IsChecked="{Binding RaycastChecked}" />
										</MenuItem.Header>
									</MenuItem>
									<MenuItem>
										<MenuItem.Header>
											<RadioButton Content="AIP" GroupName="RenderMode" IsChecked="{Binding AIPChecked}" />
										</MenuItem.Header>
									</MenuItem>
									<MenuItem>
										<MenuItem.Header>
											<RadioButton Content="MIP" GroupName="RenderMode" IsChecked="{Binding MIPChecked}" />
										</MenuItem.Header>
									</MenuItem>
									<MenuItem>
										<MenuItem.Header>
											<RadioButton Content="MinIP" GroupName="RenderMode" IsChecked="{Binding MinIPChecked}" />
										</MenuItem.Header>
									</MenuItem>
								</MenuItem>
								<MenuItem Header="显示设置(_D)">
									<MenuItem>
										<MenuItem.Header>
											<CheckBox Content="横断面" IsChecked="{Binding AxialPlaneVisible}" />
										</MenuItem.Header>
									</MenuItem>
									<MenuItem>
										<MenuItem.Header>
											<CheckBox Content="冠状面" IsChecked="{Binding CoronalPlaneVisible}" />
										</MenuItem.Header>
									</MenuItem>
									<MenuItem>
										<MenuItem.Header>
											<CheckBox Content="矢状面" IsChecked="{Binding SagittalPlaneVisible}" />
										</MenuItem.Header>
									</MenuItem>
									<MenuItem>
										<MenuItem.Header>
											<CheckBox Content="ViewBox" IsChecked="{Binding ViewBoxVisible}" />
										</MenuItem.Header>
									</MenuItem>
									<MenuItem>
										<MenuItem.Header>
											<CheckBox Content="坐标轴" IsChecked="{Binding AxisVisible}" />
										</MenuItem.Header>
									</MenuItem>
									<MenuItem Header="重置平面(_R)" Command="{Binding ResetMprPlanesCommand}" />
									<MenuItem Header="重置相机(_C)" Command="{Binding ResetCameraCommand}" />
									<MenuItem Header="调节相机(_T)" Command="{Binding TuneCameraCommand}" />
								</MenuItem>
								<MenuItem Header="调节协议(_T)" Command="{Binding TuneProtocolCommand}" />
								<MenuItem Header="截屏(_C)" Command="{Binding CaptureCommand}" />
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
				</WrapPanel>
			</Grid>
		</sd:GroupBox.Header>
		<!--Content-->
		<sd:VolumeViewport x:Name="VolumeViewport"
						   FrameToken="{Binding FrameToken}"
						   Camera="{Binding Camera}"
						   InputManager="{Binding InputManager}"
						   VolumeData="{Binding VolumeData}"
						   PreviewMode="{Binding PreviewMode}"
						   RenderMode="{Binding RenderMode}"
						   WindowWidth="{Binding WindowWidth}"
						   WindowCenter="{Binding WindowCenter}"
						   Brightness="{Binding Brightness}"
						   DensityScale="{Binding DensityScale}"
						   StepSize="{Binding StepSize}"
						   MaxStepsCount="{Binding MaxStepsCount}"
						   OpacityThreshold="{Binding OpacityThreshold}"
						   TFControlPoints="{Binding TFControlPoints}">
			<sd:ShapePresenter3D Content="{Binding AxialPlane}" />
			<sd:ShapePresenter3D Content="{Binding CoronalPlane}" />
			<sd:ShapePresenter3D Content="{Binding SagittalPlane}" />
			<sd:ShapesPresenter3D ItemsSource="{Binding Shapes}" />
			<sd:ViewBoxVisual3D IsVisible="{Binding ViewBoxVisible}" />
			<sd:AxisVisual3D IsVisible="{Binding AxisVisible}" />
		</sd:VolumeViewport>
	</sd:GroupBox>
</UserControl>
