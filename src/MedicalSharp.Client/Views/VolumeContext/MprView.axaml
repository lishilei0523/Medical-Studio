<UserControl x:Class="MedicalSharp.Client.Views.VolumeContext.MprView"
			 xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:sd="https://github.com/lishilei0523/SD.Framework"
			 mc:Ignorable="d">

	<sd:GroupBox>
		<!--Header-->
		<sd:GroupBox.Header>
			<Grid>
				<Grid.ColumnDefinitions>
					<!--Toolbar-->
					<ColumnDefinition Width="*" />
					<!--More-->
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<!--Toolbar-->
				<WrapPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
					<ItemsControl ItemsSource="{Binding ToolbarCommands}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<sd:ToggleRadioButton ToolTip.Tip="{Binding Name}"
													  IsChecked="{Binding IsChecked}"
													  IsVisible="{Binding IsVisible}"
													  GroupName="{Binding DataContext.InstanceUId,
													  RelativeSource={RelativeSource AncestorType=UserControl}}"
													  Classes="Transparent-Panel">
									<PathIcon Data="{Binding Icon, Converter={StaticResource StringToGeometryConverter}}" />
								</sd:ToggleRadioButton>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</WrapPanel>
				<!--More-->
				<WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
					<DropDownButton Content="{Binding Title}" Classes="Transparent-Panel">
						<DropDownButton.Flyout>
							<MenuFlyout>
								<MenuItem Header="渲染模式(_R)" IsEnabled="{Binding ViewEnabled}">
									<MenuItem>
										<MenuItem.Header>
											<RadioButton Content="灰度" GroupName="RenderMode" IsChecked="{Binding GrayModeChecked}" />
										</MenuItem.Header>
									</MenuItem>
									<MenuItem>
										<MenuItem.Header>
											<RadioButton Content="伪彩" GroupName="RenderMode" IsChecked="{Binding PseudoColorChecked}" />
										</MenuItem.Header>
									</MenuItem>
								</MenuItem>
								<MenuItem Header="显示设置(_D)" IsEnabled="{Binding ViewEnabled}">
									<MenuItem>
										<MenuItem.Header>
											<CheckBox Content="十字线" IsChecked="{Binding CrosshairVisible}" />
										</MenuItem.Header>
									</MenuItem>
									<MenuItem>
										<MenuItem.Header>
											<CheckBox Content="方向标识" IsChecked="{Binding DirectionVisible}" />
										</MenuItem.Header>
									</MenuItem>
									<MenuItem>
										<MenuItem.Header>
											<CheckBox Content="窗宽/窗位" IsChecked="{Binding WindowLevelVisible}" />
										</MenuItem.Header>
									</MenuItem>
									<MenuItem Header="重置十字线(_R)" Command="{Binding ResetCrosshairCommand}" />
									<MenuItem Header="重置相机(_C)" Command="{Binding ResetCameraCommand}" />
								</MenuItem>
								<MenuItem Header="预设协议(_E)" IsEnabled="{Binding ViewEnabled}">
									<ListBox ItemsSource="{Binding PresetProtocols}" SelectedItem="{Binding SelectedProtocol}">
										<ListBox.ItemTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding Name}" />
											</DataTemplate>
										</ListBox.ItemTemplate>
										<ListBox.ContextFlyout>
											<MenuFlyout>
												<MenuItem Header="刷新(_E)" Command="{Binding ReloadProtocolsCommand}" />
												<MenuItem Header="删除(_D)" Command="{Binding RemoveProtocolCommand}" />
											</MenuFlyout>
										</ListBox.ContextFlyout>
									</ListBox>
								</MenuItem>
								<MenuItem Header="调节协议(_T)" Command="{Binding TuneProtocolCommand}" />
								<MenuItem Header="截屏(_C)" Command="{Binding CaptureCommand}" />
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
				</WrapPanel>
			</Grid>
		</sd:GroupBox.Header>
		<!--Content-->
		<sd:GroupBox.Content>
			<Grid>
				<sd:MPRViewport x:Name="MPRViewport"
								FrameToken="{Binding FrameToken}"
								Camera="{Binding Camera}"
								InputManager="{Binding InputManager}"
								Plane="{Binding Plane}"
								VolumeData="{Binding VolumeData}"
								RenderMode="{Binding RenderMode}"
								WindowWidth="{Binding WindowWidth}"
								WindowCenter="{Binding WindowCenter}"
								Brightness="{Binding Brightness}"
								Contrast="{Binding Contrast}"
								InterpolationMode="{Binding InterpolationMode}"
								TFControlPoints="{Binding TFControlPoints}">
					<sd:ShapePresenter3D Content="{Binding Crosshair}" />
					<sd:ShapesPresenter3D ItemsSource="{Binding Shapes}" />
				</sd:MPRViewport>
				<Grid IsVisible="{Binding DirectionVisible}">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<WrapPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
							   IsVisible="{Binding ViewEnabled}">
						<!--Top-->
						<TextBlock Text="{Binding FourDirection.Top}" Margin="0,1,0,0" Foreground="DarkGray" />
					</WrapPanel>
					<WrapPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
							   IsVisible="{Binding ViewEnabled}">
						<!--Bottom-->
						<TextBlock Text="{Binding FourDirection.Bottom}" Margin="0,0,0,1" Foreground="DarkGray" />
					</WrapPanel>
					<WrapPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
							   IsVisible="{Binding ViewEnabled}">
						<!--Left-->
						<TextBlock Text="{Binding FourDirection.Left}" Margin="1,0,0,0" Foreground="DarkGray" />
					</WrapPanel>
					<WrapPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
							   IsVisible="{Binding ViewEnabled}">
						<!--Right-->
						<TextBlock Text="{Binding FourDirection.Right}" Margin="0,0,1,0" Foreground="DarkGray" />
					</WrapPanel>
				</Grid>
				<Grid IsVisible="{Binding WindowLevelVisible}">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<WrapPanel Grid.Row="2" Grid.Column="0" Margin="2,0,0,0" IsVisible="{Binding ViewEnabled}">
						<!--BottomLeft-->
						<TextBlock Text="WW : " Foreground="DarkGray" />
						<TextBlock Text="{Binding WindowWidth}" Foreground="DarkGray" />
					</WrapPanel>
					<WrapPanel Grid.Row="2" Grid.Column="2" Margin="0,0,2,0" IsVisible="{Binding ViewEnabled}">
						<!--BottomRight-->
						<TextBlock Text="WL : " Foreground="DarkGray" />
						<TextBlock Text="{Binding WindowCenter}" Foreground="DarkGray" />
					</WrapPanel>
				</Grid>
			</Grid>
		</sd:GroupBox.Content>
	</sd:GroupBox>
</UserControl>
