<fa:AppWindow x:Class="MedicalSharp.Client.Views.HomeContext.IndexView"
			  xmlns="https://github.com/avaloniaui"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			  xmlns:fa="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
			  xmlns:sd="https://github.com/lishilei0523/SD.Framework"
			  xmlns:cm="http://caliburnmicro.com"
			  mc:Ignorable="d"
			  Width="1440" Height="900"
			  WindowState="Maximized"
			  WindowStartupLocation="CenterScreen">

	<sd:BusyMask IsBusy="{Binding IsBusy}">
		<Grid>
			<Grid.RowDefinitions>
				<!--Header-->
				<RowDefinition Height="Auto" />
				<!--Body-->
				<RowDefinition Height="*" />
				<!--Footer-->
				<RowDefinition Height="25" />
			</Grid.RowDefinitions>
			<!--Header-->
			<Grid Grid.Row="0">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Image Grid.Column="0"
						   Source="/favicon.ico"
						   Width="24" Height="24" Margin="10,0,5,0"
						   IsHitTestVisible="False"
						   RenderOptions.BitmapInterpolationMode="HighQuality">
					</Image>
					<Menu Grid.Column="1">
						<MenuItem Header="文件(_F)">
							<MenuItem Header="打开(_O)" Command="{Binding OpenSeriesCommand}" />
							<MenuItem Header="关闭(_C)" Command="{Binding CloseSeriesCommand}" />
							<MenuItem Header="保存(_S)" cm:Message.Attach="SaveImage()" />
							<MenuItem Header="另存为(_A)" cm:Message.Attach="SaveAsImage()" />
						</MenuItem>
						<MenuItem Header="编辑(_E)">
							<MenuItem Header="组织管理(_T)" Command="{Binding ManageTissueCommand}" />
						</MenuItem>
						<MenuItem Header="视图(_V)">
							<MenuItem Header="布局(_L)">
								<MenuItem Header="布局13(_A)" Command="{Binding Layout13Command}" />
								<MenuItem Header="布局22(_B)" Command="{Binding Layout22Command}" />
							</MenuItem>
						</MenuItem>
					</Menu>
				</Grid>
			</Grid>
			<!--Body-->
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<!--Left Pannel-->
					<ColumnDefinition Width="260" />
					<!--Viewer Pannel-->
					<ColumnDefinition />
					<!--Right Pannel-->
					<ColumnDefinition Width="260" />
				</Grid.ColumnDefinitions>
				<!--Left Pannel-->
				<Grid Grid.Column="0" Margin="4,1,2,5">
					<Grid.RowDefinitions>
						<RowDefinition Height="300" />
						<RowDefinition Height="240" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<sd:GroupBox Grid.Row="0" Header="患者信息" Margin="0,0,0,2">
						<StackPanel Grid.IsSharedSizeScope="True" Margin="5,10">
							<sd:FormItem Label="患者ID：">
								<TextBlock Text="{Binding PatientInfo.PatientId}" />
							</sd:FormItem>
							<sd:FormItem Label="患者姓名：">
								<TextBlock Text="{Binding PatientInfo.Name}" />
							</sd:FormItem>
							<sd:FormItem Label="出生日期：">
								<TextBlock Text="{Binding PatientInfo.BirthDate}" />
							</sd:FormItem>
							<sd:FormItem Label="性别：">
								<TextBlock Text="{Binding PatientInfo.Sex}" />
							</sd:FormItem>
							<sd:FormItem Label="年龄：">
								<TextBlock Text="{Binding PatientInfo.Age}" />
							</sd:FormItem>
							<sd:FormItem Label="身高：">
								<TextBlock Text="{Binding PatientInfo.Height}" />
							</sd:FormItem>
							<sd:FormItem Label="体重：">
								<TextBlock Text="{Binding PatientInfo.Weight}" />
							</sd:FormItem>
						</StackPanel>
					</sd:GroupBox>
					<sd:GroupBox Grid.Row="1" Header="检查信息" Margin="0,2,0,2">
						<StackPanel Grid.IsSharedSizeScope="True" Margin="5,10">
							<sd:FormItem Label="实例UID：">
								<TextBlock Text="{Binding StudyInfo.StudyInstanceUId}" />
							</sd:FormItem>
							<sd:FormItem Label="检查日期：">
								<TextBlock Text="{Binding StudyInfo.StudyDate}" />
							</sd:FormItem>
							<sd:FormItem Label="检查时间：">
								<TextBlock Text="{Binding StudyInfo.StudyTime}" />
							</sd:FormItem>
							<sd:FormItem Label="检查描述："/>
							<TextBlock Text="{Binding StudyInfo.StudyDescription}" TextAlignment="Center" TextWrapping="Wrap" />
						</StackPanel>
					</sd:GroupBox>
					<sd:GroupBox Grid.Row="2" Header="体积信息" Margin="0,2,0,0">
						<StackPanel Grid.IsSharedSizeScope="True" Margin="5,10">
							<sd:FormItem Label="体积尺寸：">
								<TextBlock Text="{Binding VolumeInfo.VolumeSize}" />
							</sd:FormItem>
							<sd:FormItem Label="间距：">
								<TextBlock Text="{Binding VolumeInfo.Spacing}" />
							</sd:FormItem>
							<sd:FormItem Label="物理尺寸：">
								<TextBlock Text="{Binding VolumeInfo.PhysicalSize}" />
							</sd:FormItem>
							<sd:FormItem Label="斜率：">
								<TextBlock Text="{Binding VolumeInfo.RescaleSlope}" />
							</sd:FormItem>
							<sd:FormItem Label="截距：">
								<TextBlock Text="{Binding VolumeInfo.RescaleIntercept}" />
							</sd:FormItem>
							<sd:FormItem Label="默认窗宽：">
								<TextBlock Text="{Binding VolumeInfo.WindowWidth}" />
							</sd:FormItem>
							<sd:FormItem Label="默认窗位：">
								<TextBlock Text="{Binding VolumeInfo.WindowCenter}" />
							</sd:FormItem>
						</StackPanel>
					</sd:GroupBox>
				</Grid>
				<!--Viewer Pannel-->
				<Grid Grid.Column="1" Margin="2,0,2,4">
					<ContentControl cm:View.Model="{Binding LayoutViewModel}" />
				</Grid>
				<!--Right Pannel-->
				<Grid Grid.Column="2" Margin="2,1,4,5">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<sd:GroupBox Grid.Row="0" Header="组织列表" Margin="0,0,0,2">
						<ListBox ItemsSource="{Binding Tissues}" SelectedItem="{Binding SelectedTissue}">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="40" />
											<ColumnDefinition Width="50" />
											<ColumnDefinition Width="40" />
											<ColumnDefinition Width="100" />
										</Grid.ColumnDefinitions>
										<!--标记值-->
										<TextBlock Grid.Column="0" Text="{Binding MarkValue, Mode=OneWay}" 
                                                   Width="30" Padding="2" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
										<!--组织名称-->
										<TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneWay}" FontSize="12"
												   VerticalAlignment="Center" Margin="3,0" />
										<!--颜色色块-->
										<Border Grid.Column="2" Width="18" Height="18" CornerRadius="2"
												HorizontalAlignment="Center" VerticalAlignment="Center"
												BorderBrush="#CCCCCC" BorderThickness="0.5">
											<Border.Background>
												<SolidColorBrush Color="{Binding Color, Mode=OneWay}" />
											</Border.Background>
										</Border>
										<!--标记模式-->
										<ComboBox Grid.Column="3" Width="90" FontSize="11"
												  ItemsSource="{Binding DataContext.MarkModes,
												  RelativeSource={RelativeSource AncestorType=fa:AppWindow}}"
												  DisplayMemberBinding="{Binding Value}"
												  SelectedValue="{Binding SelectedMarkMode}">
										</ComboBox>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
                            <ListBox.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="创建组织" Command="{Binding AddTissueCommand}" />
                                    <MenuItem Header="编辑组织" Command="{Binding UpdateTissueCommand}" />
                                    <MenuItem Header="删除组织" Command="{Binding RemoveTissueCommand}" />
                                </MenuFlyout>
                            </ListBox.ContextFlyout>
						</ListBox>
					</sd:GroupBox>
					<sd:GroupBox Grid.Row="1" Header="统计信息" Margin="0,2,0,0">

					</sd:GroupBox>
				</Grid>
			</Grid>
			<!--Footer-->
			<Grid Grid.Row="2" Background="#FF6C6C6C">
				<WrapPanel Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
					<TextBlock Text="Volume Size : " FontSize="12" />
					<TextBlock Text="{Binding VolumeInfo.VolumeSize}" FontSize="12" />
				</WrapPanel>
				<WrapPanel Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center">
					<TextBlock Text="Series Instance UID : " FontSize="12" />
					<TextBlock Text="{Binding VolumeInfo.SeriesInstanceUId}" FontSize="12" />
				</WrapPanel>
			</Grid>
		</Grid>
	</sd:BusyMask>
</fa:AppWindow>
