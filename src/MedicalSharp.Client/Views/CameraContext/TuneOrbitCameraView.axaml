<fa:AppWindow x:Class="MedicalSharp.Client.Views.CameraContext.TuneOrbitCameraView"
			  xmlns="https://github.com/avaloniaui"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			  xmlns:fa="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
			  xmlns:sd="https://github.com/lishilei0523/SD.Framework"
			  xmlns:cm="http://caliburnmicro.com"
			  mc:Ignorable="d"
			  Width="460" Height="380" CanResize="False" ShowAsDialog="True"
			  WindowStartupLocation="CenterScreen"
			  Title="调节轨道相机">

	<sd:BusyMask IsBusy="{Binding IsBusy}">
		<Grid>
			<Grid.RowDefinitions>
				<!--表单区-->
				<RowDefinition Height="320" />
				<!--占位区-->
				<RowDefinition Height="*" />
				<!--控制区-->
				<RowDefinition Height="50" />
			</Grid.RowDefinitions>
			<!--表单区-->
			<StackPanel Grid.Row="0" Grid.IsSharedSizeScope="True" Margin="20,20">
				<sd:FormItem Label="平移速度：">
					<NumericUpDown Width="300" HorizontalAlignment="Left"
								   Minimum="1" Maximum="10" Increment="1"
								   ParsingNumberStyle="Integer" FormatString="F0"
								   Text="{Binding PanSpeed}" />
				</sd:FormItem>
				<sd:FormItem Label="旋转速度：">
					<NumericUpDown Width="300" HorizontalAlignment="Left"
								   Minimum="0.05" Maximum="0.5" Increment="0.01"
								   ParsingNumberStyle="Float" FormatString="F2"
								   Text="{Binding RotateSpeed}" />
				</sd:FormItem>
				<sd:FormItem Label="缩放速度：">
					<NumericUpDown Width="300" HorizontalAlignment="Left"
								   Minimum="0.1" Maximum="1.0" Increment="0.1"
								   ParsingNumberStyle="Float" FormatString="F1"
								   Text="{Binding ZoomSpeed}" />
				</sd:FormItem>
				<sd:FormItem Label="最小距离：">
					<NumericUpDown Width="300" HorizontalAlignment="Left"
								   Minimum="0.1" Maximum="2" Increment="0.1"
								   ParsingNumberStyle="Float" FormatString="F1"
								   Text="{Binding MinDistance}" />
				</sd:FormItem>
                <sd:FormItem Label="最大距离：">
                    <NumericUpDown Width="300" HorizontalAlignment="Left"
                                   Minimum="10" Maximum="150" Increment="1"
                                   ParsingNumberStyle="Integer" FormatString="F0"
                                   Text="{Binding MaxDistance}" />
                </sd:FormItem>
			</StackPanel>
			<!--占位区-->
			<Grid Grid.Row="1" />
			<!--控制区-->
			<Grid Grid.Row="2" Classes="Submit-Grid">
				<WrapPanel Classes="Submit-WrapPanel">
					<Button Content="确定" cm:Message.Attach="Submit()" Classes="Focus" />
					<Button Content="取消" cm:Message.Attach="TryCloseAsync('false')" />
				</WrapPanel>
			</Grid>
		</Grid>
	</sd:BusyMask>
</fa:AppWindow>
