<fa:AppWindow x:Class="MedicalSharp.Client.Views.TissueContext.AddView"
			  xmlns="https://github.com/avaloniaui"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			  xmlns:fa="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
			  xmlns:sd="https://github.com/lishilei0523/SD.Framework"
			  xmlns:cm="http://caliburnmicro.com"
			  mc:Ignorable="d"
			  Width="460" Height="500" CanResize="False" ShowAsDialog="True"
			  WindowStartupLocation="CenterScreen"
			  Title="创建组织">

	<Grid>
		<Grid.RowDefinitions>
			<!--表单区-->
			<RowDefinition Height="260" />
			<!--占位区-->
			<RowDefinition Height="*" />
			<!--控制区-->
			<RowDefinition Height="50" />
		</Grid.RowDefinitions>
		<!--表单区-->
		<StackPanel Grid.Row="0" Grid.IsSharedSizeScope="True" Margin="20,20">
			<sd:FormItem Label="组织名称：">
				<TextBox Width="300" HorizontalAlignment="Left"
						 Text="{Binding TissueName}" />
			</sd:FormItem>
			<sd:FormItem Label="标记值：">
				<NumericUpDown Width="300" HorizontalAlignment="Left"
							   Minimum="1" Maximum="255" Increment="1"
							   ParsingNumberStyle="Integer" FormatString="F0"
                               Value="{Binding MarkValue}" />
			</sd:FormItem>
			<sd:FormItem Label="标记模式：">
				<ComboBox Width="300"
						  ItemsSource="{Binding MarkModes}"
						  DisplayMemberBinding="{Binding Value}"
						  SelectedValue="{Binding SelectedMarkMode}" />
			</sd:FormItem>
			<sd:FormItem Label="组织颜色：">
				<ColorPicker Width="300" HorizontalAlignment="Left" Color="{Binding TissueColor}" />
			</sd:FormItem>
		</StackPanel>
		<!--占位区-->
		<Grid Grid.Row="1" />
		<!--控制区-->
		<Grid Grid.Row="2" Classes="Submit-Grid">
			<WrapPanel Classes="Submit-WrapPanel">
				<Button Content="确定" cm:Message.Attach="Submit()" Classes="Focus" />
				<Button Content="取消" cm:Message.Attach="TryCloseAsync('false')" />
			</WrapPanel>
		</Grid>
	</Grid>
</fa:AppWindow>
