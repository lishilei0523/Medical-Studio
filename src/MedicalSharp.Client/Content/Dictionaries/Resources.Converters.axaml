<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sd="https://github.com/lishilei0523/SD.Framework"
                    xmlns:sdm="https://github.com/lishilei0523/Medical-Studio">

    <!--形状-图标转换器-->
    <sdm:ShapeToIconConverter x:Key="ShapeToIconConverter" />
    <!--Null-True转换器-->
    <sd:NullToTrueConverter x:Key="NullToTrueConverter" />
    <!--Null-False转换器-->
    <sd:NullToFalseConverter x:Key="NullToFalseConverter" />
    <!--枚举成员转换器-->
    <sd:EnumMemberConverter x:Key="EnumMemberConverter" />
    <!--字符串-几何图标转换器-->
    <sd:StringToGeometryConverter x:Key="StringToGeometryConverter" />
    <!--停/启用描述转换器-->
    <sd:BooleanDescriptionConverter x:Key="EnabledDescriptionConverter">
        <x:String>已停用</x:String>
        <x:String>已启用</x:String>
    </sd:BooleanDescriptionConverter>
    <!--是/否描述转换器-->
    <sd:BooleanDescriptionConverter x:Key="YesNoDescriptionConverter">
        <x:String>否</x:String>
        <x:String>是</x:String>
    </sd:BooleanDescriptionConverter>
</ResourceDictionary>
