#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

//标记纹理（可读写，R8UI格式）
layout(binding = 0, r8ui) uniform uimage3D u_MarkTexture;

//多边形参数
layout(std430, binding = 1) buffer PolygonVertexBuffer
{
    vec4 u_PolygonVertices[];        //2D顶点坐标（x, y, 0, 0）
};
uniform int u_VerticesCount;         //顶点数量
uniform vec3 u_FitPlaneNormal;       //拟合平面法向量（归一化）
uniform vec3 u_FitCenter;            //拟合中心位置
uniform vec3 u_UAixs;                //U轴（归一化）
uniform vec3 u_VAixs;                //V轴（归一化）
uniform mat4 u_WorldToLocal;

//体积参数
uniform ivec3 u_VolumeSize;
uniform vec3 u_VolumeScale;

//切割模式（0=内切, 1=外切）
uniform int u_CutMode;

//标记值（1-255，0保留给未标记）
uniform uint u_MarkValue;


//判断点是否在多边形内（射线投射法）
bool PointInPolygon2D(vec2 point)
{
    bool inside = false;
    for (int i = 0, j = u_VerticesCount - 1; i < u_VerticesCount; j = i++)
    {
        vec4 vertexI = u_PolygonVertices[i];
        vec4 vertexJ = u_PolygonVertices[j];
        
        bool intersect = ((vertexI.y > point.y) != (vertexJ.y > point.y)) &&
                         (point.x < (vertexJ.x - vertexI.x) * (point.y - vertexI.y) / (vertexJ.y - vertexI.y) + vertexI.x);
        if (intersect)
        {
            inside = !inside;
        }
    }
    return inside;
}

void main()
{
    //获取当前线程对应的体素坐标
    ivec3 voxelCoord = ivec3(gl_GlobalInvocationID);
    
    //边界检查
    if (voxelCoord.x >= u_VolumeSize.x || voxelCoord.y >= u_VolumeSize.y || voxelCoord.z >= u_VolumeSize.z)
    {
        return;
    }
    
    //体素坐标 -> 纹理坐标（0-1范围） -> 世界坐标
    vec3 texCoord = (vec3(voxelCoord) + 0.5) / vec3(u_VolumeSize);
    vec3 worldPos = (texCoord - 0.5) * u_VolumeScale;
    
    //应用逆变换到局部坐标
    vec4 localPos = u_WorldToLocal * vec4(worldPos, 1.0);
    localPos /= localPos.w;
    vec3 pos = localPos.xyz;
    
    //将体素点投影到拟合平面上（使用CPU传入的U/V轴）
    vec3 delta = pos - u_FitCenter;
    float projectedU = dot(delta, u_UAixs);
    float projectedV = dot(delta, u_VAixs);
    vec2 projectedPoint = vec2(projectedU, projectedV);
    
    //判断投影点是否在多边形内
    bool inPolygon = PointInPolygon2D(projectedPoint);
    
    //根据切割模式决定
    bool inside = false;
    if (u_CutMode == 0)
    {
        //内切：挖掉多边形投影区域
        inside = inPolygon;
    }
    else
    {
        //外切：挖掉多边形投影区域之外的部分
        inside = !inPolygon;
    }

    if (inside)
    {
        uint oldMarkValue = imageLoad(u_MarkTexture, voxelCoord).r;
        if (oldMarkValue != u_MarkValue)
        {
            imageStore(u_MarkTexture, voxelCoord, uvec4(u_MarkValue, 0, 0, 0));
        }
    }
}
