#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

//标记纹理（可读写，R8UI格式）
layout(binding = 0, r8ui) uniform uimage3D u_MarkTexture;

//矩形参数
uniform float u_RectHalfWidth;           //半宽
uniform float u_RectHalfHeight;          //半高
uniform vec3 u_RectCenter;           //中心（局部空间）
uniform vec3 u_RectNormal;           //法向量（归一化）
uniform vec3 u_RectUAxis;            //U轴（宽度方向，归一化）
uniform vec3 u_RectVAxis;            //V轴（高度方向，归一化）
uniform mat4 u_WorldToLocal;

//体积纹理尺寸
uniform ivec3 u_TextureSize;

//标记值（1-255，0保留给未标记）
uniform uint u_MarkValue;

void main()
{  
    //获取当前线程对应的体素坐标
    ivec3 voxelCoord = ivec3(gl_GlobalInvocationID);
    
    //边界检查
    if (voxelCoord.x >= u_TextureSize.x || voxelCoord.y >= u_TextureSize.y || voxelCoord.z >= u_TextureSize.z)
    {
        return;
    }
    
    //体素坐标 -> 纹理坐标（0-1范围） -> 世界坐标
    vec3 texCoord = (vec3(voxelCoord) + 0.5) / vec3(u_TextureSize);
    vec3 worldPos = texCoord - 0.5;

    //应用逆变换到局部坐标
    vec4 localPos = u_WorldToLocal * vec4(worldPos, 1.0);
    localPos /= localPos.w;
    vec3 pos = localPos.xyz;
    
    //计算相对矩形中心的位置
    vec3 delta = pos - u_RectCenter;
    
    //计算在法向量方向上的投影距离
    float normalDist = dot(delta, u_RectNormal);
    
    //条件1：只在法向量背后（normalDist <= 0）
    //条件2：投影在U-V平面上的点落在矩形内
    float u = dot(delta, u_RectUAxis);
    float v = dot(delta, u_RectVAxis);
    
    bool inside = (abs(u) <= u_RectHalfWidth) &&
                  (abs(v) <= u_RectHalfHeight);    
    if (inside)
    {
        uint oldMarkValue = imageLoad(u_MarkTexture, voxelCoord).r;
        if (oldMarkValue != u_MarkValue)
        {
            imageStore(u_MarkTexture, voxelCoord, uvec4(u_MarkValue, 0, 0, 0));
        }
    }
}
