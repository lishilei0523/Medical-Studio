#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

//标记纹理（可读写，R8UI格式）
layout(binding = 0, r8ui) uniform uimage3D u_MarkTexture;

//圆柱体参数
uniform float u_CylinderRadius;          //半径
uniform float u_CylinderHeight;          //高度（沿Z轴）
uniform vec3 u_CylinderCenter;           //中心位置（局部空间）
uniform mat4 u_WorldToLocal;

//体积参数
uniform ivec3 u_VolumeSize;
uniform vec3 u_VolumeScale;

//切割模式（0=内切, 1=外切）
uniform int u_CutMode;

//标记值（1-255，0保留给未标记）
uniform uint u_MarkValue;


void main()
{
    //获取当前线程对应的体素坐标
    ivec3 voxelCoord = ivec3(gl_GlobalInvocationID);
    
    //边界检查
    if (voxelCoord.x >= u_VolumeSize.x ||
        voxelCoord.y >= u_VolumeSize.y ||
        voxelCoord.z >= u_VolumeSize.z)
    {
        return;
    }
    
    //体素坐标 -> 纹理坐标（0-1范围） -> 世界坐标
    vec3 texCoord = (vec3(voxelCoord) + 0.5) / vec3(u_VolumeSize);
    vec3 worldPos = (texCoord - 0.5) * u_VolumeScale;
    
    //应用逆变换到局部坐标
    vec4 localPos = u_WorldToLocal * vec4(worldPos, 1.0);
    localPos /= localPos.w;
    vec3 pos = localPos.xyz;
    
    //计算相对圆柱体中心的位置
    vec3 delta = pos - u_CylinderCenter;
    
    //Z-up：轴向就是Z轴
    float halfHeight = u_CylinderHeight * 0.5;
    
    //轴向判断：Z方向
    float zDist = abs(delta.z);
    
    //径向距离：X-Y平面距离
    float radialDist = length(delta.xy);
    
    //圆柱体内判断：轴向范围 [-halfHeight, halfHeight]，径向距离 <= 半径
    bool inCylinder = (zDist <= halfHeight) && (radialDist <= u_CylinderRadius);
    
    //根据切割模式决定
    bool inside = false;
    if (u_CutMode == 0)
    {
        //内切：挖掉圆柱体内部
        inside = inCylinder;
    }
    else
    {
        //外切：挖掉圆柱体外部
        inside = !inCylinder;
    }
    
    if (inside)
    {
        uint oldMarkValue = imageLoad(u_MarkTexture, voxelCoord).r;
        if (oldMarkValue != u_MarkValue)
        {
            imageStore(u_MarkTexture, voxelCoord, uvec4(u_MarkValue, 0, 0, 0));
        }
    }
}
